## Copy to `.env.local` and fill values (do not commit)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key_here

## Required for chat (text + tools)
GROQ_API_KEY=your_groq_api_key_here

## Required for vision (image questions)
OPENAI_API_KEY=your_openai_api_key_here

GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

## Optional: MCP servers (server-side only)
# MCP_SERVERS=https://your-server-1/mcp,https://your-server-2/mcp

## Windows build workaround: avoids .next/trace EPERM locks
NEXT_DISABLE_FILE_TRACING=1
