## Copy to `.env.local` and fill values (do not commit)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

## Required for chat (text + tools)
GROQ_API_KEY=

## Required for vision (image questions)
OPENAI_API_KEY=

GOOGLE_GENERATIVE_AI_API_KEY=
## Optional: MCP servers (server-side only)
# MCP_SERVERS=https://your-server-1/mcp,https://your-server-2/mcp

## Windows build workaround: avoids .next/trace EPERM locks
NEXT_DISABLE_FILE_TRACING=1

